  "keyFeatures": [
    "Monthly and specific-month payment tracking",
    "Visual status indicators (paid, due soon, overdue)",
    "Due date management with date picker",
    "Custom payment creation and removal",
    "Local storage persistence",
    "Month-by-month navigation",
    "Payment status toggle"
