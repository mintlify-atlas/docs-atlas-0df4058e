{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Pagosapp",
  "theme": "almond",
  "colors": {
    "primary": "#7abf7a",
    "light": "#accfb4",
    "dark": "#7abf7a"
  },
  "favicon": "https://media.brand.dev/ea94180d-a48c-4744-8fb0-b640c9b51e93.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/santiremedi/appPagos"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/santiremedi/appPagos"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "Core Features",
            "pages": ["features/payment-tracking", "features/due-dates", "features/custom-payments", "features/month-navigation"]
          },
          {
            "group": "User Guide",
            "pages": ["guide/managing-payments", "guide/payment-categories", "guide/local-storage"]
          },
          {
            "group": "Development",
            "pages": ["development/architecture", "development/components", "development/state-management"]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Overview",
            "pages": ["components/overview"]
          },
          {
            "group": "Core Components",
            "pages": ["components/pago", "components/mes", "components/date-picker", "components/switch"]
          },
          {
            "group": "Modals",
            "pages": ["components/add-new-item", "components/payment-modal"]
          }
        ]
      }
    ]
  }
}
